[
  {
    "tabTitle": "Model",
    "charts": {
      "disease_name": {
        "chartType": "fullPie",
        "title": "Disease"
      },
      "gene_symbol": {
        "chartType": "bar",
        "title": "Gene"
      }
    },
    "filters": {
      "tabs": [
        {
          "title": "Project Selection",
          "fields": ["project_id"]
        },
        {
          "title": "Model",
          "fields": [
            "identifier",
            "name",
            "disease_name",
            "phenotype",
            "maintainer",
            "producer",
            "gene_symbol",
            "taxonomy"
          ]
        }
      ]
    },
    "table": {
      "enabled": true,
      "pageLimit": {
        "limit": 10000
      },
      "fields": [
        "project_id",
        "submitter_id",
        "identifier",
        "name",
        "disease_name",
        "phenotype",
        "maintainer",
        "producer"
      ],
      "columns": {
        "submitter_id": {
          "sortable": false
        }
      }
    },
    "dropdowns": {
      "download-table": {
        "title": "Download Table",
        "leftIcon": "gen3:download",
        "rightIcon": "gen3:chevron-down",
        "dropdownItems": [
          {
            "enabled": true,
            "type": "data-json",
            "title": "JSON",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-json",
            "actionArgs": {
              "filename": "phenomics_models.json"
            }
          },
          {
            "enabled": true,
            "type": "data-csv",
            "title": "CSV",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-csv",
            "actionArgs": {
              "filename": "phenomics_models.csv"
            }
          }
        ]
      }
    },
    "buttons": [],
    "loginForDownload": false,
    "guppyConfig": {
      "dataType": "model",
      "nodeCountTitle": "Models",
      "fieldMapping": [
        { "field": "identifier", "name": "Model ID" },
        { "field": "disease_name", "name": "Disease" },
        { "field": "phenotype", "name": "Phenotype" },
        { "field": "maintainer", "name": "Maintainer" },
        { "field": "producer", "name": "Producer" }
      ],
      "manifestMapping": {
        "resourceIndexType": "file",
        "resourceIdField": "object_id",
        "referenceIdFieldInResourceIndex": "model_id",
        "referenceIdFieldInDataIndex": "model_id"
      },
      "accessibleFieldCheckList": ["project_id"],
      "accessibleValidationField": "project_id"
    }
  },
  {
    "tabTitle": "Sample",
    "charts": {
      "biological_sex": {
        "chartType": "fullPie",
        "title": "Biological Sex"
      },
      "tissue_organ": {
        "chartType": "bar",
        "title": "Tissue / Organ"
      }
    },
    "filters": {
      "tabs": [
        {
          "title": "Sample",
          "fields": ["project_id", "genotype", "biological_sex", "tissue_organ"]
        }
      ]
    },
    "table": {
      "enabled": true,
      "pageLimit": {
        "limit": 10000
      },
      "fields": [
        "project_id",
        "submitter_id",
        "genotype",
        "biological_sex",
        "tissue_organ"
      ],
      "columns": {
        "submitter_id": {
          "sortable": false
        }
      }
    },
    "dropdowns": {},
    "buttons": [],
    "loginForDownload": false,
    "guppyConfig": {
      "dataType": "sample",
      "nodeCountTitle": "Samples",
      "fieldMapping": [
        { "field": "genotype", "name": "Genotype" },
        { "field": "biological_sex", "name": "Biological Sex" },
        { "field": "tissue_organ", "name": "Tissue / Organ" }
      ],
      "manifestMapping": {
        "resourceIndexType": "file",
        "resourceIdField": "object_id",
        "referenceIdFieldInResourceIndex": "sample_id",
        "referenceIdFieldInDataIndex": "sample_id"
      },
      "accessibleFieldCheckList": ["project_id"],
      "accessibleValidationField": "project_id"
    }
  },
  {
    "tabTitle": "Data Files",
    "charts": {
      "file_type": {
        "chartType": "stackedBar",
        "title": "File Type"
      },
      "file_format": {
        "chartType": "stackedBar",
        "title": "File Format"
      }
    },
    "filters": {
      "tabs": [
        {
          "title": "File",
          "fields": ["project_id", "data_type", "data_format", "data_category"]
        }
      ]
    },
    "table": {
      "enabled": true,
      "fields": ["project_id", "file_name", "file_size", "_file_id", "object_id"]
    },
    "guppyConfig": {
      "dataType": "file",
      "fieldMapping": [
        {
          "field": "_file_id",
          "name": "GUID"
        }
      ],
      "nodeCountTitle": "Files",
      "manifestMapping": {
        "resourceIndexType": "project",
        "resourceIdField": "project_id",
        "referenceIdFieldInResourceIndex": "project_id",
        "referenceIdFieldInDataIndex": "project_id"
      },
      "accessibleFieldCheckList": ["project_id"],
      "accessibleValidationField": "project_id",
      "downloadAccessor": ["object_id"]
    },
    "buttons": [
      {
        "enabled": true,
        "type": "manifest",
        "title": "Download File Manifest",
        "leftIcon": "datafile",
        "rightIcon": "download",
        "actionArgs": {
          "filename": "data_table_manifest.csv"
        }
      }
    ],
    "loginForDownload": true
  }
]
